[submodule "thirdparty/assimp"]
	path = thirdparty/assimp
	url = https://github.com/assimp/assimp.git
[submodule "thirdparty/glfw"]
	path = thirdparty/glfw
	url = https://github.com/glfw/glfw.git
[submodule "thirdparty/stb"]
	path = thirdparty/stb
	url = https://github.com/nothings/stb.git
[submodule "thirdparty/glm"]
	path = thirdparty/glm
	url = https://github.com/g-truc/glm.git
[submodule "thirdparty/sdl"]
	path = thirdparty/sdl
	url = git@github.com:libsdl-org/SDL.git
	branch = SDL2
[submodule "thirdparty/sdl_mixer"]
	path = thirdparty/sdl_mixer
	url = git@github.com:libsdl-org/SDL_mixer.git
	branch = SDL2
